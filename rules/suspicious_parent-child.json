            "severity": "medium"
        },
        {
            "parent": ["chrome.exe", "winword.exe", "excel.exe", "outlook.exe"],
            "child": "cmd.exe",
            "mitre": "T1059.003",
            "severity": "medium"
        },
        {
            "parent": ["chrome.exe", "winword.exe", "excel.exe", "outlook.exe"],
            "child": "python.exe",
            "mitre": "T1059.006",
            "severity": "high"
        },
        {
            "parent": ["chrome.exe", "winword.exe", "excel.exe", "outlook.exe"],
            "child": "wscript.exe",
            "mitre": "T1059.007",
            "severity": "high"
        },
        {
            "parent": ["chrome.exe", "winword.exe", "excel.exe", "outlook.exe", "explorer.exe"],
